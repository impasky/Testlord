# Sunucu
DATABASE_URL="postgresql://lordlar:lordlar@localhost:5432/lordlar_cagi"
JWT_SECRET="degistir-bunu-en-az-32-karakterlik-rastgele-bir-dize"
PORT=3000
NODE_ENV=development

# Arayüz
VITE_API_URL="http://localhost:3000"

# CORS: virgülle ayrılmış liste. localhost ve 127.0.0.1 farklı origin sayılır,
# ikisini de yazmazsan tarayıcı isteği düşer.
WEB_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"

# Hız sınırı. Genel sınır oturuma bağlı (operatör NAT'ı arkasındaki oyuncular
# birbirini kilitlemesin), kayıt/giriş ise IP başına.
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=60

# Hata izleme. Boş bırakılırsa kapalıdır ve dışarıya hiçbir şey gönderilmez.
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE=0.05

# fatal|error|warn|info|debug|trace
LOG_LEVEL=info

# E-posta. log = sadece sunucu log'una yazar, dışarıya hiçbir şey gitmez.
# resend = api.resend.com'a gönderir (ücretsiz katmanı var).
EPOSTA_TASIYICI=log
EPOSTA_ANAHTAR=""
EPOSTA_GONDEREN="Lordlar Çağı <bildirim@ornek.com>"

# Parola sıfırlama bağlantısının tabanı — arayüzün herkese açık adresi.
UYGULAMA_URL="http://localhost:5173"
