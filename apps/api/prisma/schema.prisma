// Lordlar Çağı — veri şeması
// docs/03 §3'ün birebir uygulaması.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  createdAt    DateTime        @default(now())
  lords        Lord[]
  resets       PasswordReset[]
}

/// Parola sıfırlama jetonu.
///
/// Jetonun kendisi değil, SHA-256 özeti saklanır: veritabanı sızarsa
/// jetonlarla hesap ele geçirilemesin. E-postaya giden ham jeton yalnızca
/// bir kez, üretildiği anda var olur.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model World {
  id        String     @id @default(cuid())
  name      String
  playerCap Int        @default(120)
  status    String     @default("open") // open | full | closed
  openedAt  DateTime   @default(now())
  lords     Lord[]
  regions   Region[]
  alliances Alliance[]
  paktlar   Pakt[]
}

model Lord {
  id      String @id @default(cuid())
  userId  String
  worldId String
  name    String

  level Int @default(1)
  xp    Int @default(0)

  guc          Int @default(5)
  dayaniklilik Int @default(5)
  liderlik     Int @default(5)
  kurnazlik    Int @default(5)
  statPoints   Int @default(0)

  altin Int @default(0)
  demir Int @default(0)
  erzak Int @default(0)

  fame                Int @default(0)
  fortressFameAccrued Int @default(0)
  elo                 Int @default(1200)
  pvpWins             Int @default(0)
  pvpLosses           Int @default(0)

  /// Malikânenin harita üzerindeki çıpası. Yürüyüş mesafesi buradan ölçülür.
  /// Kayıtta ring 4'e en az yüklü hex'e yerleştirilir; kimse buraya saldıramaz.
  homeQ Int @default(0)
  homeR Int @default(0)

  lastTickAt      DateTime  @default(now())
  protectionUntil DateTime?
  woundedUntil    DateTime?
  dailyAttacks    Int       @default(0)
  dailyResetAt    DateTime  @default(now())

  /// Oyuncunun oyunu en son ne zaman açtığı. "Sen yokken ne oldu" özeti
  /// bu ana göre hesaplanır.
  lastSeenAt        DateTime  @default(now())
  /// Giriş serisi: kaç gün üst üste girildi. Türetilemiyor — tek bir
  /// zaman damgası "kaç gün üst üste" sorusunu cevaplayamaz, o bir geçmiş.
  girisSerisi       Int       @default(0)
  /// Serinin en son işlendiği gün. Aynı gün ikinci girişte seri artmasın diye.
  girisSerisiGunu   DateTime?
  /// Günlük görev ödülünün en son alındığı gün. Bu da türetilemiyor: ödülün
  /// verilmesi mevcut hiçbir kayda iz bırakmıyor, kaynak artışı altına
  /// karışıyor.
  gunlukOdulGunu    DateTime?
  /// Haftalık sefer ödülünün en son alındığı an. Hangi seferin açık olduğu
  /// SAKLANMIYOR — hafta numarasından türetiliyor (packages/shared/sefer.ts).
  seferOduluHaftasi DateTime?
  /// Öğreticiyi bitirdiği (ya da geçtiği) an. Türetilemiyor: öğreticinin
  /// okunması oyunda hiçbir iz bırakmıyor — okuyan da okumayan da aynı
  /// durumda duruyor. Sunucuda tutuluyor cunku tam ekran bir tanıtımı
  /// ikinci kez göstermek, kartı ikinci kez göstermekten çok daha rahatsız
  /// edici; tarayıcı deposu silinince ya da telefon değişince geri gelirdi.
  ogreticiBittiAt   DateTime?

  /// Arma: oyuncunun heraldik kimliği (docs/10 §1.1). Beş küçük anahtar,
  /// hiçbir sayıya dokunmuyor. Boşsa lord adından türetiliyor.
  armaKalkan String?
  armaDesen  String?
  armaRenk1  String?
  armaRenk2  String?
  armaSembol String?

  /// Üyesi olduğu ittifak. Yoksa null — ittifak zorunlu değil.
  allianceId     String?
  /// İttifak içindeki rütbe: null = üye, "yasli" = yaşlı.
  /// Lider ayrıca saklanmıyor — o Alliance.leaderLordId'de.
  ittifakRutbe   String?
  /// En son ittifaktan ayrıldığı an. Bekleme süresi buradan ölçülüyor:
  /// ittifaktan çıkıp hemen başkasına girmek, saldırı kilidini kalkan gibi
  /// kullanmayı mümkün kılardı.
  allianceLeftAt DateTime?
  /// En son hangi ekranda olduğu. Tek işi ölçüm: oyuncular oyunu hangi
  /// ekranda bırakıyor? Bu soru tahminle cevaplanamaz ve cevabı olmadan
  /// bir sonraki iyileştirme de tahmin olur. (docs/08 İ7)
  lastScreen     String?
  createdAt      DateTime  @default(now())

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  world       World              @relation(fields: [worldId], references: [id], onDelete: Cascade)
  items       Item[]
  units       ArmyUnit[]
  gearLines   GearLine[]
  generals    LordGeneral[]
  regions     Region[]
  queues      Queue[]
  marches     March[]
  events      Event[]
  scouts      Scout[]
  messages    AllianceMessage[]
  gonderilen  Shipment[]         @relation("ShipmentFrom")
  gelen       Shipment[]         @relation("ShipmentTo")
  bagislar    AllianceDonation[]
  basvurular  AllianceBasvuru[]
  alliance    Alliance?          @relation("AllianceMembers", fields: [allianceId], references: [id])
  ledAlliance Alliance?          @relation("AllianceLeader")

  attackerBattles Battle[] @relation("AttackerBattles")
  defenderBattles Battle[] @relation("DefenderBattles")

  @@unique([userId, worldId])
  @@index([allianceId])
  @@index([worldId, fame])
  @@index([worldId, elo])
}

model Item {
  id           String   @id @default(cuid())
  lordId       String
  slot         String
  tier         Int
  rarity       String
  upgradeLevel Int      @default(0)
  equipped     Boolean  @default(false)
  createdAt    DateTime @default(now())

  lord Lord @relation(fields: [lordId], references: [id], onDelete: Cascade)

  @@index([lordId, equipped])
}

model ArmyUnit {
  id           String  @id @default(cuid())
  lordId       String
  unitType     String
  count        Int
  locationType String // home | region | march
  locationId   String?

  lord Lord @relation(fields: [lordId], references: [id], onDelete: Cascade)

  @@unique([lordId, unitType, locationType, locationId])
  @@index([locationType, locationId])
}

model GearLine {
  lordId String
  line   String // silahlik | zirhhane | nalbant
  level  Int    @default(0)

  lord Lord @relation(fields: [lordId], references: [id], onDelete: Cascade)

  @@id([lordId, line])
}

model LordGeneral {
  id         String    @id @default(cuid())
  lordId     String
  generalKey String
  level      Int       @default(1)
  xp         Int       @default(0)
  slotIndex  Int?
  restUntil  DateTime?

  lord Lord @relation(fields: [lordId], references: [id], onDelete: Cascade)

  @@unique([lordId, generalKey])
}

model Region {
  /// Veritabanı kimliği. world-map.json'daki numara DEĞİLDİR: birden çok dünya
  /// (shard) aynı haritayı kullandığı için harita numarası dünya başına tekrar eder.
  id       Int    @id @default(autoincrement())
  /// world-map.json'daki bölge numarası (1-61). Kanonik harita verisine anahtar.
  mapId    Int
  worldId  String
  name     String
  type     String
  province String
  q        Int
  r        Int
  ring     Int
  level    Int    @default(1)

  ownerLordId String?
  npcGarrison Json
  incomeMult  Float   @default(1)

  storeAltin Int @default(0)
  storeDemir Int @default(0)
  storeErzak Int @default(0)

  lastTickAt  DateTime  @default(now())
  shieldUntil DateTime?

  world      World      @relation(fields: [worldId], references: [id], onDelete: Cascade)
  owner      Lord?      @relation(fields: [ownerLordId], references: [id])
  scouts     Scout[]
  targetedBy Alliance[] @relation("AllianceTarget")

  @@unique([worldId, mapId])
  @@unique([worldId, q, r])
  @@index([worldId, ownerLordId])
}

model March {
  id           String   @id @default(cuid())
  worldId      String
  lordId       String
  fromRegionId Int?
  toRegionId   Int
  kind         String // attack | return
  army         Json
  generalIds   Json
  loot         Json?
  /// Yürüyüşün hex mesafesi. Dönüş süresi buradan hesaplanır.
  /// Eskiden gidiş süresinden geri türetiliyordu; ilk saldırının süresi
  /// kısaltılabilir olunca o türetme yanlış mesafe veriyor.
  distance     Int      @default(1)
  departAt     DateTime
  arriveAt     DateTime
  resolved     Boolean  @default(false)

  lord Lord @relation(fields: [lordId], references: [id], onDelete: Cascade)

  @@index([resolved, arriveAt])
  @@index([lordId, resolved])
}

model Battle {
  id             String   @id @default(cuid())
  worldId        String
  regionId       Int
  attackerLordId String
  defenderLordId String?
  seed           String
  result         String // attacker_win | defender_win
  captured       Boolean  @default(false)
  log            Json
  createdAt      DateTime @default(now())

  attacker Lord  @relation("AttackerBattles", fields: [attackerLordId], references: [id], onDelete: Cascade)
  defender Lord? @relation("DefenderBattles", fields: [defenderLordId], references: [id])

  @@index([attackerLordId, createdAt])
  @@index([defenderLordId, createdAt])
}

model Queue {
  id        String   @id @default(cuid())
  lordId    String
  kind      String // train | craft | upgrade_item | upgrade_gear | upgrade_region
  payload   Json
  startedAt DateTime @default(now())
  finishAt  DateTime
  resolved  Boolean  @default(false)

  lord Lord @relation(fields: [lordId], references: [id], onDelete: Cascade)

  @@index([resolved, finishAt])
  @@index([lordId, resolved])
}

/// İttifak: birlikte oynayan lordlar.
///
/// Çekirdek kasten küçük: ad, etiket, lider, üyeler. Takviye, ortak hedef ve
/// sohbet bunun üstüne gelir. Tek kuralı bile tek başına değerli —
/// birbirine saldıramamak, "yalnız değilim" hissinin en somut hâli.
model Alliance {
  id           String   @id @default(cuid())
  worldId      String
  /// Görünen ad. Dünya içinde benzersiz.
  name         String
  /// Kısa etiket, sıralamada ve harita üzerinde adın yanında görünür.
  tag          String
  leaderLordId String   @unique
  createdAt    DateTime @default(now())

  /// İttifakın ortak hedefi. Bir tane, bilerek: beş işaretli hedef
  /// koordinasyon değil gürültüdür. Tek hedef bir karardır ve karar
  /// tartışılır — sohbetin konusu olur.
  targetRegionId Int?
  targetSetAt    DateTime?
  /// Hedefin yanına yazılan kısa not ("cuma akşamı", "mancınık lazım").
  targetNote     String?

  /// Toplam bağış XP'si.
  ///
  /// Bağış satırlarının toplamından TÜRETİLEBİLİRDİ ve ilk tasarımda öyleydi;
  /// ama bu sayı ticaret tavanından takviye hızına kadar her yerde okunuyor
  /// ve her okumada bir toplama sorgusu açmak istemedik. Bağış işleminin
  /// içinde artıyor, başka hiçbir yerde yazılmıyor.
  ///
  /// SEVİYE saklanmıyor: her zaman bu XP'den türetiliyor (ittifakSeviyesi).
  /// İki sayıyı birden tutmak, bir gün birinin diğerinden sapması demekti.
  xp Int @default(0)

  /// Katılım türü: "acik" = herkes doğrudan girer, "basvuru" = lider onaylar.
  ///
  /// Varsayılan "basvuru". İlk hâlinde katılım herkese açıktı ve liderin
  /// söz hakkı yoktu; ittifak seviyesi gelince (bkz. xp) bu delik büyüdü —
  /// aylarca bağışla kazanılan ayrıcalıklar kapıdan girene bedava oluyordu.
  katilim String @default("basvuru")

  /// Başvuru için istenen en düşük lord seviyesi. 1 = eşik yok.
  /// Liderin yerine ön eleme yapıyor; tavanı balance.json belirliyor.
  asgariSeviye Int @default(1)

  /// Liderin panoya yazdığı kalıcı duyuru. Sohbetten farkı akıp gitmemesi:
  /// "günde 5 bağış yapın" her yeni üyenin görmesi gereken bir kural.
  duyuru String?

  world      World              @relation(fields: [worldId], references: [id], onDelete: Cascade)
  leader     Lord               @relation("AllianceLeader", fields: [leaderLordId], references: [id], onDelete: Cascade)
  members    Lord[]             @relation("AllianceMembers")
  messages   AllianceMessage[]
  paktA      Pakt[]             @relation("PaktA")
  paktB      Pakt[]             @relation("PaktB")
  bagislar   AllianceDonation[]
  basvurular AllianceBasvuru[]
  target     Region?            @relation("AllianceTarget", fields: [targetRegionId], references: [id])

  @@unique([worldId, name])
  @@unique([worldId, tag])
  @@index([worldId])
}

/// İttifak bağışı: üyenin ittifağı büyütmek için verdiği kaynak.
///
/// Satır olarak saklanıyor çünkü iki soruyu birden cevaplıyor: günlük hak
/// kaldı mı (bugünkü satırları say) ve üye bu hafta ne kattı (haftalık
/// satırları say). İkisi için ayrı sayaç tutmak, sayaçların kayıtlarla
/// birbirini tutmadığı bir hâl demekti.
model AllianceDonation {
  id         String   @id @default(cuid())
  allianceId String
  lordId     String
  /// İttifağa kazandırdığı XP. Bağış anındaki lord seviyesine bağlı, o
  /// yüzden satırda saklanıyor: sonradan yeniden hesaplanamaz.
  xp         Int
  altin      Int
  demir      Int
  erzak      Int
  createdAt  DateTime @default(now())

  alliance Alliance @relation(fields: [allianceId], references: [id], onDelete: Cascade)
  lord     Lord     @relation(fields: [lordId], references: [id], onDelete: Cascade)

  @@index([allianceId, createdAt])
  @@index([lordId, createdAt])
}

/// İttifağa başvuru.
///
/// Reddedilen başvuru SİLİNMİYOR, durumu değişiyor: ret beklemesi bu satırın
/// kararAt'ından ölçülüyor. Silseydik reddedilen lord aynı dakika yeniden
/// başvurabilirdi ve ret hiçbir şey ifade etmezdi.
///
/// Lord başına ittifak başına tek satır: yeni başvuru eskisini yeniden
/// açıyor. Geçmiş biriktirmenin oyun içinde karşılığı yok, tablo ise her
/// reddedilen denemeyle büyürdü.
model AllianceBasvuru {
  id         String  @id @default(cuid())
  allianceId String
  lordId     String
  /// Başvuranın kısa notu ("Lv12, aktifim"). Liderin kararı için.
  mesaj      String?
  /// bekliyor | kabul | ret | geri_cekildi
  durum      String  @default("bekliyor")

  createdAt    DateTime  @default(now())
  /// Kabul/ret/geri çekme anı. Ret beklemesi buradan ölçülüyor.
  kararAt      DateTime?
  /// Kararı veren lord (lider ya da yaşlı). Kayıt defterinde görünüyor.
  kararVerenId String?

  alliance Alliance @relation(fields: [allianceId], references: [id], onDelete: Cascade)
  lord     Lord     @relation(fields: [lordId], references: [id], onDelete: Cascade)

  @@unique([allianceId, lordId])
  @@index([allianceId, durum])
  @@index([lordId, durum])
}

/// Saldırmazlık paktı: iki ittifak birbirine saldırmamaya söz veriyor.
///
/// Taraflar KANONİK sırada saklanıyor (aId < bId). X–Y ile Y–X aynı pakt;
/// sıralamadan geçirmeseydik benzersizlik kısıtı yön değiştiren bir teklifi
/// yeni bir pakt sanardı ve aynı iki ittifak arasında iki satır oluşurdu.
///
/// Süresi dolmuş pakt SİLİNMİYOR, geçersiz sayılıyor: temizleyecek bir
/// işçiye gerek kalmıyor ve iki ittifakın geçmişte anlaşmış olduğu bilgisi
/// kaybolmuyor.
model Pakt {
  id           String @id @default(cuid())
  worldId      String
  /// Kanonik sırada iki taraf.
  aId          String
  bId          String
  /// Teklifi hangi taraf açtı. Kabul/ret yetkisi ÖTEKİ tarafın liderinde.
  teklifEdenId String
  /// teklif | yururlukte | feshediliyor | bitti
  durum        String @default("teklif")

  createdAt   DateTime  @default(now())
  kabulAt     DateTime?
  /// Fesih ihbarının verildiği an ve paktın gerçekten biteceği an.
  /// Aradaki sürede pakt HÂLÂ koruyor — mekaniğin bütün değeri burada.
  fesihAt     DateTime?
  biterAt     DateTime?
  fesihEdenId String?

  world World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  a     Alliance @relation("PaktA", fields: [aId], references: [id], onDelete: Cascade)
  b     Alliance @relation("PaktB", fields: [bId], references: [id], onDelete: Cascade)

  @@unique([aId, bId])
  @@index([worldId])
  @@index([aId])
  @@index([bId])
}

/// Kaynak sevkiyatı: bir müttefikten diğerine giden yük.
///
/// Kaynak da yol alıyor. Anında gönderim, kuşatma altındaki oyuncuyu
/// sınırsız besler ve saldırının ekonomik anlamını yok ederdi.
model Shipment {
  id         String   @id @default(cuid())
  worldId    String
  fromLordId String
  toLordId   String
  altin      Int      @default(0)
  demir      Int      @default(0)
  erzak      Int      @default(0)
  departAt   DateTime
  arriveAt   DateTime
  resolved   Boolean  @default(false)

  from Lord @relation("ShipmentFrom", fields: [fromLordId], references: [id], onDelete: Cascade)
  to   Lord @relation("ShipmentTo", fields: [toLordId], references: [id], onDelete: Cascade)

  @@index([resolved, arriveAt])
  @@index([fromLordId, departAt])
  @@index([toLordId, resolved])
}

/// İttifak sohbeti mesajı.
///
/// İttifak silinince mesajlar da gidiyor: sohbet ittifakın kendisi kadar
/// yaşıyor, dağılmış bir topluluğun konuşmalarını saklamanın karşılığı yok.
model AllianceMessage {
  id         String   @id @default(cuid())
  allianceId String
  lordId     String
  text       String
  createdAt  DateTime @default(now())

  alliance Alliance @relation(fields: [allianceId], references: [id], onDelete: Cascade)
  lord     Lord     @relation(fields: [lordId], references: [id], onDelete: Cascade)

  @@index([allianceId, createdAt])
  @@index([lordId, createdAt])
}

/// Bir keşif raporu: bir lordun bir bölge hakkındaki istihbaratı.
///
/// Rapor bir FOTOĞRAF, canlı bir görüş değil. Bu yüzden `snapshot` saklanıyor:
/// süresi geçince satır silinmiyor, "eski istihbarat" olarak gösteriliyor.
/// Eski bilgi de bilgidir; ona güvenip güvenmemek oyuncunun kararı olmalı.
///
/// Lord başına bölge başına tek satır: yeni keşif eskisini ezer. Geçmiş
/// tutmanın oyun içinde bir karşılığı yok, tablo ise sürekli büyürdü.
model Scout {
  id        String   @id @default(cuid())
  lordId    String
  regionId  Int
  createdAt DateTime @default(now())
  expiresAt DateTime
  /// Keşif anındaki garnizon, depo, tahkimat ve sahip adı.
  snapshot  Json

  lord   Lord   @relation(fields: [lordId], references: [id], onDelete: Cascade)
  region Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@unique([lordId, regionId])
  @@index([lordId, expiresAt])
}

/// Oyuncuya gösterilen olay akışı (saldırıya uğradın, kuyruk bitti, bölge kaybettin...)
model Event {
  id        String    @id @default(cuid())
  lordId    String
  kind      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  lord Lord @relation(fields: [lordId], references: [id], onDelete: Cascade)

  @@index([lordId, createdAt])
}

/// Oyuncu şikâyeti.
///
/// Otomatik süzgeç kusursuz olamaz; kaçanı insana taşıyan yol bu. Şikâyet
/// edilen lord silinmiyor, yalnızca kaydediliyor — kararı yönetici verir.
model Report {
  id         String   @id @default(cuid())
  reporterId String
  targetId   String
  reason     String
  createdAt  DateTime @default(now())

  @@unique([reporterId, targetId])
  @@index([targetId, createdAt])
}
